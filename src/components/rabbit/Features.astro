---
const items = [
  { no: '01', en: 'Exotic-only', jp: 'うさぎ専門', body: '年間2,000件以上のうさぎ診察実績。一般診療の片手間ではなく、うさぎのためだけに設計されたクリニックです。' },
  { no: '02', en: 'Equipment', jp: '最新設備', body: 'デジタルレントゲン、3Dエコー、CO₂レーザー、専用麻酔器。大型動物病院と同等の機器を、小さな命のために。' },
  { no: '03', en: 'Volume', jp: '豊富な症例', body: '不正咬合・消化管うっ滞・膀胱結石──うさぎ特有の疾患に対する臨床データを蓄積し、最適な治療を選択します。' },
  { no: '04', en: 'Warmth', jp: 'やさしい看護', body: '体温管理のされた診察台、においと音に配慮した待合室。ストレスを最小化する環境設計。' },
];
---
<section id="features" class="relative py-32 md:py-48 px-6 md:px-10 bg-ink text-cream">
  <div class="grid grid-cols-12 gap-4 md:gap-6">
    <div class="col-span-12 md:col-span-4">
      <div class="eyebrow text-rose">— (04) Why Us</div>
      <h2 class="mt-4 font-display text-[clamp(36px,5.4vw,88px)] leading-[0.95] tracking-tightest">
        <span class="italic">Four</span><br />
        reasons to<br />
        <span class="text-rose italic">entrust</span> us.
      </h2>
      <p class="mt-8 text-[13px] leading-[2] text-cream/70 max-w-[36ch] font-mincho">
        選ばれ続けるには理由があります。私たちが大切にしている、4つの柱をご紹介します。
      </p>
    </div>
    <div class="col-span-12 md:col-span-8 md:border-l border-cream/15 md:pl-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-y-14 gap-x-10">
        {items.map((it) => (
          <article class="group">
            <div class="flex items-baseline justify-between">
              <span class="font-display italic text-[28px] text-rose">({it.no})</span>
              <span class="text-[11px] tracking-[0.3em] uppercase text-cream/50">Pillar</span>
            </div>
            <h3 class="mt-4 font-display text-[32px] md:text-[38px] leading-[1.05] tracking-tight">
              {it.en}.
            </h3>
            <div class="mt-1 font-mincho text-[14px] text-rose/90">{it.jp}</div>
            <p class="mt-5 text-[13px] leading-[2] text-cream/70">{it.body}</p>
            <div class="mt-6 hair border-cream/10"></div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
