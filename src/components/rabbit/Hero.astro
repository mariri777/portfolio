---
---
<section id="top" class="relative min-h-[100svh] w-full overflow-hidden pt-24 md:pt-28">
  <!-- Top marquee -->
  <div class="absolute top-20 md:top-24 left-0 right-0 overflow-hidden text-primary/70">
    <div class="marquee-track py-2 text-[12px] tracking-[0.22em] uppercase" data-marquee>
      {Array.from({ length: 2 }).map(() => (
        <span class="px-6 inline-flex items-center gap-6">
          <span>Est. 2026 — Tokyo</span>
          <span class="opacity-40">◆</span>
          <span>Rabbit Specialty Clinic</span>
          <span class="opacity-40">◆</span>
          <span>うさぎのためだけに設計された専門医療</span>
          <span class="opacity-40">◆</span>
          <span>Open Daily · Hours 9:00 — 19:00</span>
          <span class="opacity-40">◆</span>
        </span>
      ))}
    </div>
  </div>

  <div class="relative z-10 grid grid-cols-12 gap-4 md:gap-6 px-6 md:px-10 pt-16 md:pt-28">
    <!-- Eyebrow + meta -->
    <div class="col-span-12 md:col-span-3 flex md:flex-col justify-between md:justify-start gap-4 md:gap-8 mt-2">
      <div>
        <div class="eyebrow">— (01) Introducing</div>
        <div class="mt-4 text-[13px] text-ink/60 font-mincho leading-relaxed max-w-[220px]">
          私たちは、うさぎ<br />だけを診る専門医療<br />チームです。
        </div>
      </div>
      <div class="hidden md:block text-[11px] text-ink/50 tracking-widest">
        N 35.6762° / E 139.6503°<br />
        TOKYO · JAPAN
      </div>
    </div>

    <!-- Hero heading -->
    <div class="col-span-12 md:col-span-9">
      <h1 class="font-display text-ink leading-[0.88] tracking-tightest" data-hero-heading>
        <span class="block">
          <span class="split-wrap"><span class="reveal-inner inline-block text-[clamp(56px,11vw,200px)] italic">Rabbit</span></span>
        </span>
        <span class="block md:-mt-4">
          <span class="split-wrap"><span class="reveal-inner inline-block text-[clamp(56px,11vw,200px)]">Specialty</span></span>
        </span>
        <span class="block md:-mt-4 flex items-end gap-6 flex-wrap">
          <span class="split-wrap"><span class="reveal-inner inline-block text-[clamp(56px,11vw,200px)] text-primary italic">Clinic.</span></span>
          <span class="split-wrap"><span class="reveal-inner inline-block font-mincho text-[clamp(20px,2.6vw,36px)] text-ink/70 pb-3 md:pb-6">うさぎ専門病院</span></span>
        </span>
      </h1>
    </div>
  </div>

  <!-- Image + CTA row -->
  <div class="relative z-10 grid grid-cols-12 gap-4 md:gap-6 px-6 md:px-10 mt-12 md:mt-20">
    <div class="col-span-12 md:col-span-5 flex flex-col justify-end">
      <p class="font-mincho text-[16px] md:text-[18px] leading-[2] text-ink/80 max-w-[420px]">
        小さな鼓動に、最先端の技術と、確かなやさしさを。<br />
        山田太郎・田中花子を中心とする専門チームが、<br />
        不正咬合から消化器疾患、画像診断・手術まで、<br />
        うさぎのためだけの医療を提供します。
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-5">
        <a
          href="#reserve"
          data-magnetic
          data-hover="cta"
          class="btn-magnetic group relative px-7 py-4 rounded-full bg-primary text-cream text-[12px] tracking-[0.22em] uppercase hover:bg-plum transition-colors"
        >
          <span class="label">Webでご予約</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="tel:0312345678" data-hover="link" class="text-[13px] tracking-[0.18em] uppercase text-ink/70 hover:text-primary transition-colors">
          Tel. 03-1234-5678
        </a>
      </div>
    </div>

    <div class="col-span-12 md:col-span-7 relative">
      <div class="relative aspect-[5/6] md:aspect-[16/11] overflow-hidden rounded-[2px]" data-parallax-wrap>
        <img
          data-parallax
          src="https://images.unsplash.com/photo-1535241749838-299277b6305f?w=1800&q=80&auto=format&fit=crop"
          alt="やさしい表情のうさぎ"
          class="absolute inset-0 w-full h-[120%] object-cover clip-img"
          loading="eager"
        />
        <div class="absolute top-4 left-4 text-[10px] text-cream/80 tracking-[0.3em] uppercase mix-blend-difference">
          / Cover 01 — 2026
        </div>
        <div class="absolute bottom-4 right-4 text-[10px] text-cream/80 tracking-[0.3em] uppercase mix-blend-difference text-right">
          Photographed<br />in natural light
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute -bottom-10 left-0 hidden md:flex items-center gap-3 text-[10px] tracking-[0.3em] uppercase text-ink/60">
        <span class="inline-block w-6 h-[1px] bg-ink/40"></span>
        Scroll to explore
      </div>
    </div>
  </div>

  <!-- Bottom meta line -->
  <div class="relative z-10 mt-24 md:mt-32 px-6 md:px-10 flex items-end justify-between gap-6 pb-10">
    <div class="flex flex-col gap-1 text-[11px] tracking-[0.28em] uppercase text-ink/60">
      <span>Opening Hours</span>
      <span class="text-ink">Mon–Fri 9–19 / Sat 9–13</span>
    </div>
    <div class="hidden md:block text-[11px] tracking-[0.28em] uppercase text-ink/60 text-right">
      <div>— No. / 001</div>
      <div class="text-ink">Directed by Dr. Yamada</div>
    </div>
  </div>
</section>
