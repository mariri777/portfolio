---
const hours = [
  { day: 'Mon — Fri', jp: '月〜金', am: '9:00 — 12:30', pm: '15:00 — 19:00' },
  { day: 'Saturday', jp: '土曜', am: '9:00 — 13:00', pm: '—' },
  { day: 'Sun / Holiday', jp: '日・祝', am: '休診', pm: '—' },
];
const prices = [
  { no: '01', en: 'Consultation', jp: '初診料', price: '¥ 3,300', note: '問診・視診・一般身体検査' },
  { no: '02', en: 'Full Check-up', jp: '総合健康診断', price: '¥ 16,500', note: '血液・画像・歯科検査' },
  { no: '03', en: 'Dental Trimming', jp: '臼歯トリミング', price: '¥ 11,000〜', note: '麻酔下・1回' },
  { no: '04', en: 'Spay / Neuter', jp: '避妊・去勢', price: '¥ 55,000〜', note: '術前検査・1泊入院込み' },
  { no: '05', en: 'Radiograph', jp: 'レントゲン1方向', price: '¥ 4,400', note: 'デジタル処理' },
  { no: '06', en: 'Hotel / Night', jp: 'ホテル1泊', price: '¥ 5,500〜', note: '獣医師常駐・投薬対応可' },
];
---
<section id="hours" class="relative py-28 md:py-44 px-6 md:px-10">
  <div class="grid grid-cols-12 gap-4 md:gap-6">
    <div class="col-span-12 md:col-span-4">
      <div class="eyebrow">— (08) Hours & Fees</div>
      <h2 class="mt-4 font-display text-[clamp(36px,5.4vw,88px)] leading-[0.95] tracking-tightest">
        When<br />& <span class="italic text-primary">how much.</span>
      </h2>
      <p class="mt-8 text-[13px] leading-[2] text-ink/70 font-mincho max-w-[32ch]">
        診療は完全予約制。急患の場合は必ず事前にお電話ください。
      </p>
    </div>

    <div class="col-span-12 md:col-span-8">
      <!-- Hours -->
      <div class="mb-16 md:mb-24">
        <div class="flex items-baseline justify-between mb-6">
          <span class="font-display italic text-[24px]">Opening Hours</span>
          <span class="text-[11px] tracking-[0.28em] uppercase text-ink/60">診療時間</span>
        </div>
        <div class="hair"></div>
        {hours.map((h) => (
          <div class="grid grid-cols-12 py-5 hair items-center hover:bg-blush/40 transition-colors px-2 -mx-2">
            <div class="col-span-5 md:col-span-4">
              <span class="font-display italic text-[20px]">{h.day}</span>
              <span class="ml-3 font-mincho text-[12px] text-ink/60">{h.jp}</span>
            </div>
            <div class="col-span-3 md:col-span-4 text-[14px] text-ink/80 tabular-nums">{h.am}</div>
            <div class="col-span-4 md:col-span-4 text-[14px] text-ink/80 tabular-nums text-right md:text-left">{h.pm}</div>
          </div>
        ))}
      </div>

      <!-- Pricing -->
      <div>
        <div class="flex items-baseline justify-between mb-6">
          <span class="font-display italic text-[24px]">Fee Menu</span>
          <span class="text-[11px] tracking-[0.28em] uppercase text-ink/60">料金（税込）</span>
        </div>
        <div class="hair"></div>
        {prices.map((p) => (
          <div class="grid grid-cols-12 gap-2 py-5 hair items-baseline group hover:bg-blush/40 transition-colors px-2 -mx-2">
            <div class="col-span-1 text-[11px] tracking-[0.2em] text-primary/80">— {p.no}</div>
            <div class="col-span-11 md:col-span-5">
              <div class="font-display italic text-[22px] leading-none">{p.en}.</div>
              <div class="font-mincho text-[13px] text-ink/60 mt-1">{p.jp}</div>
            </div>
            <div class="col-span-6 md:col-span-4 text-[13px] text-ink/70 font-mincho">{p.note}</div>
            <div class="col-span-6 md:col-span-2 text-right font-display text-[22px] italic tabular-nums">{p.price}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
