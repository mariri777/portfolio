---
const services = [
  { no: '01', en: 'General', jp: '一般診療', desc: '食欲不振・下痢・くしゃみなど、日常の小さな変化に。経験豊富な獣医師が丁寧に診察します。', img: 'https://images.unsplash.com/photo-1452857297128-d9c29adba80b?w=1200&q=80&auto=format&fit=crop' },
  { no: '02', en: 'Prevention', jp: '予防医療', desc: 'ワクチン、寄生虫予防、定期健康診断。病気になる前の「守る医療」を大切に。', img: 'https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=1200&q=80&auto=format&fit=crop' },
  { no: '03', en: 'Surgery', jp: '外科手術', desc: '避妊・去勢から腫瘍摘出まで、うさぎに特化した麻酔管理で安全な手術を行います。', img: 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1200&q=80&auto=format&fit=crop' },
  { no: '04', en: 'Dental', jp: '歯科治療', desc: '不正咬合・臼歯トリミング。うさぎ最大の課題である歯科疾患を専門的にケア。', img: 'https://images.unsplash.com/photo-1548767797-d8c844163c4c?w=1200&q=80&auto=format&fit=crop' },
  { no: '05', en: 'Check-up', jp: '健康診断', desc: '年2回を推奨。血液検査・レントゲン・超音波を組み合わせた総合診断。', img: 'https://images.unsplash.com/photo-1591871937573-74dbba515c4c?w=1200&q=80&auto=format&fit=crop' },
  { no: '06', en: 'Imaging', jp: '画像診断', desc: 'デジタルレントゲン、超音波、CT対応。小さな体にやさしい最新機器。', img: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=1200&q=80&auto=format&fit=crop' },
  { no: '07', en: 'Hotel', jp: 'ペットホテル', desc: '獣医師常駐のホテル。持病のある子も安心してお預けいただけます。', img: 'https://images.unsplash.com/photo-1507149833265-60c372daea22?w=1200&q=80&auto=format&fit=crop' },
  { no: '08', en: 'Grooming', jp: 'グルーミング', desc: '爪切り・耳掃除・毛球対策まで、体調に合わせたやさしいケア。', img: 'https://images.unsplash.com/photo-1535241749838-299277b6305f?w=1200&q=80&auto=format&fit=crop' },
];
---
<section id="services" class="relative overflow-hidden" data-services>
  <div class="services-pin relative w-full h-[100svh]">
    <div class="absolute inset-x-0 top-0 px-6 md:px-10 pt-28 md:pt-32 z-10">
      <div class="grid grid-cols-12 gap-4 md:gap-6 items-end">
        <div class="col-span-12 md:col-span-6">
          <div class="eyebrow">— (03) Care Menu</div>
          <h2 class="mt-4 font-display text-[clamp(36px,5.6vw,92px)] leading-[0.95] tracking-tightest">
            <span class="italic">Eight</span> ways<br />
            to <span class="text-primary italic">protect</span> them.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-4 md:col-start-9 text-right text-[11px] tracking-[0.28em] uppercase text-ink/60">
          Scroll — Horizontal<br />横スクロールでご覧ください
        </div>
      </div>
    </div>

    <div class="services-track flex items-end gap-6 md:gap-10 pl-6 md:pl-10 pr-[10vw] absolute inset-0 pt-[38svh] md:pt-[40svh]" data-services-track>
      {services.map((s) => (
        <article class="service-card group relative w-[78vw] sm:w-[58vw] md:w-[34vw] lg:w-[28vw] shrink-0">
          <div class="relative aspect-[4/5] overflow-hidden bg-blush">
            <img src={s.img} alt={s.jp} class="w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105" loading="lazy" />
            <div class="absolute top-3 left-3 text-[10px] text-cream/90 mix-blend-difference tracking-[0.3em] uppercase">— {s.no}</div>
          </div>
          <div class="mt-5 flex items-baseline justify-between gap-4">
            <div>
              <div class="font-display italic text-[26px] md:text-[30px] leading-none">{s.en}.</div>
              <div class="font-mincho text-[13px] text-ink/70 mt-1">{s.jp}</div>
            </div>
            <div class="w-10 h-10 rounded-full border border-ink/20 grid place-items-center shrink-0 group-hover:bg-primary group-hover:text-cream group-hover:border-primary transition-colors">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
          <p class="mt-3 text-[13px] leading-[1.9] text-ink/70 max-w-[32ch]">{s.desc}</p>
        </article>
      ))}
      <div class="shrink-0 w-[20vw]"></div>
    </div>
  </div>
</section>
