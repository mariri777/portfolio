---
const flow = [
  { no: '01', t: 'WEB / LINE で予約', d: 'ご希望の日時をお選びください。最短当日のご予約も可能です。' },
  { no: '02', t: '無料カウンセリング', d: '担当ドクターがご相談を伺い、最適なプランをご提案します。' },
  { no: '03', t: '施術', d: 'ご納得いただいた上で、安心して施術を受けていただけます。' },
  { no: '04', t: 'アフターケア', d: '1年間の無料アフター診察 / LINEでいつでも医師に相談可能。' },
];
---
<section id="reserve" class="relative py-24 md:py-36 bg-inkSoft text-ivory overflow-hidden">
  <!-- Soft gradient bg -->
  <div class="absolute inset-0 pointer-events-none opacity-40" style="background: radial-gradient(60% 50% at 80% 10%, rgba(217,182,162,0.4), transparent 60%), radial-gradient(50% 40% at 10% 90%, rgba(200,168,120,0.25), transparent 60%);"></div>

  <div class="relative max-w-[1320px] mx-auto px-5 md:px-10">
    <div class="grid grid-cols-12 gap-6 md:gap-10 items-end mb-12 md:mb-16">
      <div class="col-span-12 lg:col-span-7">
        <div class="eyebrow-lux text-rosegold mb-5">— reservation</div>
        <h2 class="font-mincho leading-[1.12] font-light text-[clamp(30px,4.4vw,62px)]">
          <span class="block">無料カウンセリング、</span>
          <span class="block text-rosegold">いつでも。</span>
        </h2>
      </div>
      <div class="col-span-12 lg:col-span-5">
        <p class="font-mincho text-[15px] leading-[2.1] text-ivory/80 max-w-[460px]">
          まずはお気軽にご相談ください。<br />
          WEB予約 / LINE / お電話の3つの方法でお選びいただけます。
        </p>
      </div>
    </div>

    <!-- CTA grid -->
    <div class="grid md:grid-cols-3 gap-3 md:gap-4 mb-16 md:mb-24">
      <a href="#" class="group relative bg-ivory/[0.04] hover:bg-ivory/[0.08] border border-ivory/15 p-7 md:p-9 rounded-[2px] transition-colors flex flex-col justify-between">
        <div>
          <div class="label-en text-rosegold">/ way 01</div>
          <h3 class="mt-3 font-cormorant text-[28px] md:text-[32px]">WEB予約</h3>
          <p class="mt-3 font-mincho text-[13px] leading-[1.9] text-ivory/75">24時間受付。最短で当日予約も可能です。</p>
        </div>
        <span class="mt-8 inline-flex items-center gap-3 text-[11px] tracking-[0.28em] uppercase text-rosegold">
          予約する
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>

      <a href="#" class="group relative bg-[#06C755]/15 hover:bg-[#06C755]/25 border border-[#06C755]/40 p-7 md:p-9 rounded-[2px] transition-colors flex flex-col justify-between">
        <div>
          <div class="label-en text-[#9be7b5]">/ way 02</div>
          <h3 class="mt-3 font-cormorant text-[28px] md:text-[32px]">LINEで相談</h3>
          <p class="mt-3 font-mincho text-[13px] leading-[1.9] text-ivory/85">画像送信OK。気軽な質問もこちらから。</p>
        </div>
        <span class="mt-8 inline-flex items-center gap-3 text-[11px] tracking-[0.28em] uppercase text-[#9be7b5]">
          友だち追加
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>

      <a href="tel:0312345678" class="group relative bg-ivory/[0.04] hover:bg-ivory/[0.08] border border-ivory/15 p-7 md:p-9 rounded-[2px] transition-colors flex flex-col justify-between">
        <div>
          <div class="label-en text-rosegold">/ way 03</div>
          <h3 class="mt-3 font-cormorant text-[28px] md:text-[32px]">お電話</h3>
          <p class="mt-3 font-cormorant text-[24px] md:text-[28px] text-rosegold">03-1234-5678</p>
          <p class="mt-2 font-mincho text-[12px] text-ivory/70">10:00 — 20:00（不定休）</p>
        </div>
        <span class="mt-6 inline-flex items-center gap-3 text-[11px] tracking-[0.28em] uppercase text-rosegold">
          発信する
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>

    <!-- Flow -->
    <div class="border-t border-ivory/15 pt-12 md:pt-16">
      <div class="label-en text-rosegold mb-8">/ flow</div>
      <div class="grid md:grid-cols-4 gap-6 md:gap-8">
        {flow.map((f) => (
          <div class="relative">
            <div class="font-cormorant italic text-[44px] text-rosegold leading-none">{f.no}</div>
            <h3 class="mt-4 font-cormorant text-[22px]">{f.t}</h3>
            <p class="mt-3 font-mincho text-[13px] leading-[1.9] text-ivory/75">{f.d}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Inline form -->
    <div class="mt-16 md:mt-24 bg-ivory text-inkSoft p-7 md:p-12 rounded-[2px]">
      <div class="grid grid-cols-12 gap-6 md:gap-10">
        <div class="col-span-12 lg:col-span-4">
          <div class="eyebrow-lux mb-4">— quick form</div>
          <h3 class="font-cormorant text-[28px] md:text-[36px] leading-snug">予約・お問い合わせ<br />フォーム</h3>
          <p class="mt-4 font-mincho text-[13px] leading-[2] text-inkSoft/75">
            必須項目をご記入の上、送信してください。<br />
            通常24時間以内にご返信いたします。
          </p>
        </div>
        <form class="col-span-12 lg:col-span-8 grid grid-cols-2 gap-4 md:gap-5" onsubmit="event.preventDefault(); alert('送信ありがとうございます。担当者よりご連絡いたします。');">
          <label class="col-span-2 md:col-span-1 block">
            <span class="block label-en mb-2">/ name *</span>
            <input type="text" required class="w-full bg-linen border-0 px-4 py-3 text-[14px] focus:outline-none focus:ring-1 focus:ring-mochaDeep" placeholder="山田 花子" />
          </label>
          <label class="col-span-2 md:col-span-1 block">
            <span class="block label-en mb-2">/ tel *</span>
            <input type="tel" required class="w-full bg-linen border-0 px-4 py-3 text-[14px] focus:outline-none focus:ring-1 focus:ring-mochaDeep" placeholder="090-1234-5678" />
          </label>
          <label class="col-span-2 block">
            <span class="block label-en mb-2">/ email *</span>
            <input type="email" required class="w-full bg-linen border-0 px-4 py-3 text-[14px] focus:outline-none focus:ring-1 focus:ring-mochaDeep" placeholder="example@lume.clinic" />
          </label>
          <label class="col-span-2 md:col-span-1 block">
            <span class="block label-en mb-2">/ menu</span>
            <select class="w-full bg-linen border-0 px-4 py-3 text-[14px] focus:outline-none focus:ring-1 focus:ring-mochaDeep">
              <option>二重整形</option>
              <option>肌管理</option>
              <option>小顔施術</option>
              <option>医療脱毛</option>
              <option>美容注射</option>
              <option>その他 / 相談したい</option>
            </select>
          </label>
          <label class="col-span-2 md:col-span-1 block">
            <span class="block label-en mb-2">/ preferred date</span>
            <input type="date" class="w-full bg-linen border-0 px-4 py-3 text-[14px] focus:outline-none focus:ring-1 focus:ring-mochaDeep" />
          </label>
          <label class="col-span-2 block">
            <span class="block label-en mb-2">/ message</span>
            <textarea rows="4" class="w-full bg-linen border-0 px-4 py-3 text-[14px] focus:outline-none focus:ring-1 focus:ring-mochaDeep" placeholder="ご希望や気になることをご記入ください"></textarea>
          </label>
          <label class="col-span-2 flex items-start gap-3 text-[12px] text-inkSoft/75">
            <input type="checkbox" required class="mt-1 accent-mochaDeep" />
            <span>
              <a href="#" class="underline">プライバシーポリシー</a>に同意の上、送信します。
            </span>
          </label>
          <div class="col-span-2 flex justify-end">
            <button type="submit" class="btn-lux">
              <span>送信する</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
