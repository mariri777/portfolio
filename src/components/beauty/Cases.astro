---
const cases = [
  {
    title: '二重整形（埋没法 2点）',
    age: '20代女性',
    period: '施術直後',
    price: '¥49,800',
    before: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=1000&q=80&auto=format&fit=crop',
    after: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=1000&q=80&auto=format&fit=crop',
  },
  {
    title: 'HIFU + エラボトックス',
    age: '30代女性',
    period: '施術 1ヶ月後',
    price: '¥77,800',
    before: 'https://images.unsplash.com/photo-1554151228-14d9def656e4?w=1000&q=80&auto=format&fit=crop',
    after: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=1000&q=80&auto=format&fit=crop',
  },
  {
    title: '水光注射 + ハイドラフェイシャル',
    age: '20代女性',
    period: '施術 1週間後',
    price: '¥56,000',
    before: 'https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?w=1000&q=80&auto=format&fit=crop',
    after: 'https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?w=1000&q=80&auto=format&fit=crop',
  },
];
---
<section id="cases" class="relative py-24 md:py-36 bg-nude/40">
  <div class="max-w-[1320px] mx-auto px-5 md:px-10">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-12 md:mb-16">
      <div>
        <div class="eyebrow-lux mb-5">— before / after</div>
        <h2 class="font-mincho text-inkSoft leading-[1.12] font-light text-[clamp(28px,4vw,52px)]">
          <span class="block">確かな変化を、</span>
          <span class="block text-mochaDeep">症例写真で。</span>
        </h2>
      </div>
      <p class="max-w-[420px] font-mincho text-[14px] leading-[2] text-inkSoft/70">
        実際の症例写真をスライダーで比較できます。<br />
        ※モニター様にご許可をいただいた上で掲載しています。
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 md:gap-6">
      {cases.map((c, i) => (
        <article class="bg-ivory ring-soft rounded-[2px] overflow-hidden">
          <div class="ba-slider" data-ba>
            <img src={c.after} class="ba-after" alt={`${c.title} after`} loading="lazy" />
            <div class="ba-before-wrap" data-ba-before>
              <img src={c.before} class="ba-before" alt={`${c.title} before`} loading="lazy" />
            </div>
            <div class="ba-handle" data-ba-handle></div>
            <div class="absolute top-3 left-3 px-2.5 py-1 bg-ivory/85 text-[10px] tracking-[0.25em] text-inkSoft">BEFORE</div>
            <div class="absolute top-3 right-3 px-2.5 py-1 bg-inkSoft/90 text-[10px] tracking-[0.25em] text-ivory">AFTER</div>
          </div>
          <div class="p-5 md:p-6">
            <div class="flex items-center justify-between text-[11px] tracking-[0.22em] text-mochaDeep">
              <span>{`CASE ${String(i + 1).padStart(2, '0')}`}</span>
              <span>{c.period}</span>
            </div>
            <h3 class="mt-3 font-cormorant text-[22px] md:text-[24px] text-inkSoft leading-snug">{c.title}</h3>
            <div class="mt-3 flex items-center justify-between text-[12px] text-inkSoft/70">
              <span>{c.age}</span>
              <span class="font-cormorant text-[16px] text-mochaDeep">{c.price}〜</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-10 text-[11px] leading-[1.8] text-inkSoft/55 max-w-[820px]">
      ※掲載の症例写真は個人の感想であり、効果には個人差があります。施術にはリスク・副作用が伴います。
      腫れ・内出血・痛みが生じる場合があり、ダウンタイムには個人差があります。詳しくはカウンセリング時にご説明します。
    </p>
  </div>
</section>

<script>
  function initBeforeAfter() {
    document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
      const before = el.querySelector<HTMLElement>('[data-ba-before]');
      const handle = el.querySelector<HTMLElement>('[data-ba-handle]');
      if (!before || !handle) return;
      let dragging = false;

      const setPos = (clientX: number) => {
        const rect = el.getBoundingClientRect();
        const x = Math.min(Math.max(clientX - rect.left, 0), rect.width);
        const pct = (x / rect.width) * 100;
        before.style.width = pct + '%';
        handle.style.left = pct + '%';
      };

      const onDown = (e: PointerEvent) => {
        dragging = true;
        (e.target as HTMLElement).setPointerCapture?.(e.pointerId);
        setPos(e.clientX);
      };
      const onMove = (e: PointerEvent) => {
        if (!dragging) return;
        setPos(e.clientX);
      };
      const onUp = () => { dragging = false; };

      el.addEventListener('pointerdown', onDown);
      el.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBeforeAfter);
  } else {
    initBeforeAfter();
  }
</script>
