---
---
<section id="top" class="relative pt-24 md:pt-28 pb-16 md:pb-24 overflow-hidden">
  <!-- Marquee -->
  <div class="absolute top-16 md:top-20 inset-x-0 overflow-hidden text-mochaDeep/70 pointer-events-none">
    <div class="b-marquee py-2 text-[11px] tracking-[0.34em] uppercase">
      {Array.from({ length: 2 }).map(() => (
        <span class="px-8 inline-flex items-center gap-8">
          <span>Lume Aesthetic Clinic</span>
          <span class="opacity-40">◆</span>
          <span>Omotesando · Tokyo</span>
          <span class="opacity-40">◆</span>
          <span>Korean style natural beauty</span>
          <span class="opacity-40">◆</span>
          <span>Est. 2024</span>
          <span class="opacity-40">◆</span>
        </span>
      ))}
    </div>
  </div>

  <div class="max-w-[1320px] mx-auto px-5 md:px-10 grid grid-cols-12 gap-5 md:gap-8 items-end pt-12 md:pt-20">
    <!-- Heading -->
    <div class="col-span-12 lg:col-span-7">
      <div class="eyebrow-lux mb-6">— quietly beautiful</div>
      <h1 class="font-mincho text-inkSoft leading-[1.12] tracking-tight">
        <span class="block text-[clamp(30px,4.6vw,64px)] font-light whitespace-nowrap">あなたらしい、</span>
        <span class="block text-[clamp(30px,4.6vw,64px)] font-light text-mochaDeep whitespace-nowrap">美しさへ、ととのえる。</span>
      </h1>
      <div class="mt-5 font-cormorant italic text-mochaDeep/80 text-[clamp(18px,2.2vw,30px)] tracking-wide">
        — your most quiet, luminous self.
      </div>
      <p class="mt-8 max-w-[520px] font-mincho text-[15px] md:text-[16px] leading-[2.1] text-inkSoft/80">
        二重整形・肌管理・小顔・医療脱毛・美容注射まで、<br class="hidden md:inline" />
        一人ひとりに最適な施術をご提案します。
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3 md:gap-4">
        <a href="#reserve" class="btn-lux">
          <span>無料カウンセリング</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="#" class="btn-ghost">
          <span>LINEで相談</span>
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-6 text-[11px] tracking-[0.22em] text-inkSoft/60">
        <span class="inline-flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-mocha"></span>
          表参道駅 徒歩2分
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-mocha"></span>
          完全個室・プライバシー保護
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-mocha"></span>
          症例数 12,000件 突破
        </span>
      </div>
    </div>

    <!-- Image collage -->
    <div class="col-span-12 lg:col-span-5">
      <div class="grid grid-cols-6 grid-rows-6 gap-3 md:gap-4 aspect-[4/5]">
        <div class="col-span-4 row-span-4 relative overflow-hidden ring-soft rounded-[2px] grain">
          <img
            src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=1200&q=80&auto=format&fit=crop"
            alt="施術を受ける女性の横顔"
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
          />
          <div class="absolute bottom-3 left-3 label-en text-ivory mix-blend-difference">/ no.01 — clinic</div>
        </div>
        <div class="col-span-2 row-span-3 relative overflow-hidden ring-soft rounded-[2px]">
          <img
            src="https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?w=900&q=80&auto=format&fit=crop"
            alt="美容クリニックの内装"
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <div class="col-span-2 row-span-3 relative overflow-hidden ring-soft rounded-[2px] bg-linen flex items-center justify-center">
          <div class="text-center px-3">
            <div class="font-cormorant italic text-[28px] md:text-[36px] text-mochaDeep leading-none">since</div>
            <div class="font-cormorant text-[40px] md:text-[56px] text-inkSoft leading-none mt-1">2024</div>
            <div class="mt-3 label-en">est. omotesando</div>
          </div>
        </div>
        <div class="col-span-4 row-span-2 relative overflow-hidden ring-soft rounded-[2px]">
          <img
            src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=1200&q=80&auto=format&fit=crop"
            alt="ナチュラルな肌の女性"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Brand strip -->
  <div class="max-w-[1320px] mx-auto px-5 md:px-10 mt-16 md:mt-24">
    <div class="hair-line"></div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 py-7 text-center">
      <div>
        <div class="font-cormorant text-[32px] md:text-[40px] text-mochaDeep leading-none">12,000+</div>
        <div class="mt-2 label-en">case experience</div>
      </div>
      <div>
        <div class="font-cormorant text-[32px] md:text-[40px] text-mochaDeep leading-none">4.92</div>
        <div class="mt-2 label-en">google rating</div>
      </div>
      <div>
        <div class="font-cormorant text-[32px] md:text-[40px] text-mochaDeep leading-none">98%</div>
        <div class="mt-2 label-en">repeat visit</div>
      </div>
      <div>
        <div class="font-cormorant text-[32px] md:text-[40px] text-mochaDeep leading-none">¥0</div>
        <div class="mt-2 label-en">counseling fee</div>
      </div>
    </div>
    <div class="hair-line"></div>
  </div>
</section>
