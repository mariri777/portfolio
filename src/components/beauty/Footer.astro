    </div>

    <div class="col-span-12 lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-10">
      <div>
        <div class="label-en mb-4">/ menu</div>
        <ul class="space-y-3 text-[13px] text-inkSoft/80">
          <li><a href="#treatments" class="hover:text-mochaDeep transition-colors">二重整形</a></li>
          <li><a href="#treatments" class="hover:text-mochaDeep transition-colors">肌管理</a></li>
          <li><a href="#treatments" class="hover:text-mochaDeep transition-colors">小顔施術</a></li>
          <li><a href="#treatments" class="hover:text-mochaDeep transition-colors">医療脱毛</a></li>
          <li><a href="#treatments" class="hover:text-mochaDeep transition-colors">美容注射</a></li>
        </ul>
      </div>
      <div>
        <div class="label-en mb-4">/ about</div>
        <ul class="space-y-3 text-[13px] text-inkSoft/80">
          <li><a href="#doctor" class="hover:text-mochaDeep transition-colors">ドクター紹介</a></li>
          <li><a href="#features" class="hover:text-mochaDeep transition-colors">クリニックの特徴</a></li>
          <li><a href="#cases" class="hover:text-mochaDeep transition-colors">症例写真</a></li>
          <li><a href="#voice" class="hover:text-mochaDeep transition-colors">お客様の声</a></li>
          <li><a href="#faq" class="hover:text-mochaDeep transition-colors">よくある質問</a></li>
