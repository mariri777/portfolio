  <div class="border-t border-mochaDeep/15">
    <div class="max-w-[1320px] mx-auto px-5 md:px-10 py-6 flex flex-wrap items-center justify-between gap-4 text-[11px] tracking-[0.2em] text-inkSoft/55 uppercase">
