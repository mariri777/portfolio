---
import Layout from '../../layouts/Layout.astro';
import Preloader from '../../components/rabbit/Preloader.astro';
import Cursor from '../../components/rabbit/Cursor.astro';
import Nav from '../../components/rabbit/Nav.astro';
import Hero from '../../components/rabbit/Hero.astro';
import Intro from '../../components/rabbit/Intro.astro';
import Services from '../../components/rabbit/Services.astro';
import Features from '../../components/rabbit/Features.astro';
import DirectorMessage from '../../components/rabbit/DirectorMessage.astro';
import Doctors from '../../components/rabbit/Doctors.astro';
import Facilities from '../../components/rabbit/Facilities.astro';
import HoursPricing from '../../components/rabbit/HoursPricing.astro';
import FAQ from '../../components/rabbit/FAQ.astro';
import Access from '../../components/rabbit/Access.astro';
import ReservationCTA from '../../components/rabbit/ReservationCTA.astro';
import Footer from '../../components/rabbit/Footer.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '') || '/';
---
<Layout>
  <a
    href={BASE}
    class="fixed bottom-4 left-4 md:bottom-6 md:left-6 z-[100] inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-cream/90 backdrop-blur border border-primary/25 text-[11px] tracking-[0.22em] text-primary hover:bg-primary hover:text-cream transition-colors shadow-[0_10px_30px_-10px_rgba(184,90,125,0.35)]"
  >
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    Portfolio
  </a>
  <Preloader />
  <Cursor />
  <Nav />
  <main>
    <Hero />
    <Intro />
    <Services />
    <Features />
    <DirectorMessage />
    <Doctors />
    <Facilities />
    <HoursPricing />
    <FAQ />
    <Access />
    <ReservationCTA />
  </main>
  <Footer />
</Layout>

<script>
  import { initSmoothScroll } from '../../scripts/smoothScroll';
  import { initCursor } from '../../scripts/cursor';
  import { initMagnetic } from '../../scripts/magnetic';
  import { initAnimations } from '../../scripts/animations';

  initSmoothScroll();
  initCursor();
  initMagnetic();
  initAnimations();
</script>
