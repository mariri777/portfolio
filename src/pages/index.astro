---
import '../styles/global.css';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE = 'https://mariri777.github.io/portfolio';

// サービス・ツール
const services = [
  {
    // いまは見られない状態なので、リンクなしで「おやすみ中」と表示する。再開したら URL を戻す
    href: null,
    title: '超!企業DB',
    sub: 'AI が掘る、日本株の発見。',
    kind: 'Webサービス',
    summary:
      '東証上場企業の有報・決算資料・適時開示を AI が読み込み、「ひとことで言うと何の会社か」「似たビジネスの会社」「市場が見落としていそうな論点」を銘柄ごとに一枚で見せる、個人投資家向けの銘柄分析サービス。業界マップ、スクリーニング、当たりも外れも公開する AI 予測トラッカーまで運営しています。',
    tags: ['Next.js', 'Cloudflare Workers', 'D1', 'AI 解析'],
    cover: null,
    cta: 'サービスを見る',
  },
  {
    href: 'https://mariri777.github.io/language-practice/',
    title: '日々.',
    sub: 'ことばを、すこしずつ、毎日。',
    kind: '語学ツール集',
    summary:
      '中国語・韓国語・日本語を学ぶためのツール集。作文ドリル、書写と音読のジャーナル、聞き取り4択、AI による読解補助と作文添削、手書きの漢字検索まで、母国語ごとのチャンネルに揃えました。記録は端末に保存され、オフラインでも使えます。',
    tags: ['3言語対応', 'HSK / TOPIK / JLPT', 'オフライン対応'],
    cover: `${BASE}/covers/hibi.png`,
    cta: 'ツールを使う',
  },
  {
    href: `${BASE}/tools/kikketsusui.html`,
    title: '気血水カルテ',
    sub: '中医学のものさしで、いまの体をみる。',
    kind: 'セルフチェックツール',
    summary:
      '中医学の問診と舌診から、いまかたよっている「証」と、今日からできる養生法を出すセルフチェック。二十四節気と時刻に合わせた一言も自動で入ります。1枚のHTMLだけで動きます。',
    tags: ['中医学', '問診・舌診', '単体HTML'],
    cover: `${BASE}/covers/kikketsusui.png`,
    cta: 'チェックしてみる',
  },
];

// ゲーム
const games = [
  {
    href: 'https://sono-hantei.pages.dev/',
    title: 'その判定、言うか。',
    sub: 'サッカー監督シミュレーション',
    summary:
      '2部リーグのクラブの監督になって、1シーズンで昇格を目指すゲーム。敵は相手チームだけでなく、ときどき起きる「怪しい判定」。怒るのか、飲み込むのか。1プレイ約15分、結末は何通りもあります。',
    tags: ['3D', 'マルチエンディング', '約15分'],
    cover: `${BASE}/covers/soccer-og.jpg`,
  },
  {
    href: 'https://mariri777.github.io/eiketsu-tairan/',
    title: '英傑大乱',
    sub: 'WORLD HEROES RAMPAGE',
    summary:
      '世界史の英雄になって史実の合戦に乱入する、一人称視点の一騎当千アクション。第1ステージはワーテルローの戦い。実際の戦闘経過がそのままゲームの進行になっていて、遊ぶほど世界史に詳しくなります。',
    tags: ['一人称アクション', '世界史', 'Three.js'],
    cover: `${BASE}/covers/eiketsu.png`,
  },
];

// 100日チャレンジ（2026-11-15 時点）
const days = { done: 47, tool: 34, game: 8, lp: 5, href: 'https://mariri777.github.io/100days_challenges/' };

// Webデザイン
const designs = [
  {
    slug: 'kodo-gym',
    href: `${BASE}/lp/gym.html`,
    no: '06',
    title: 'パーソナルジム ランディングページ',
    sub: '鼓動 KODO',
    role: 'デザイン + 実装',
    year: '2026',
    tags: ['フィットネス', 'ダーク×ブラス', 'モーション豊富'],
    summary:
      '「変わる、を確かに。」をコンセプトにしたパーソナルトレーニングジムのLP試作。チャコール × くすんだブラス（琥珀）の落ち着いた配色で、鼓動（heartbeat）をモチーフに構成。マウス追従ブロブ、3Dティルトのプログラムカード、ドラッグできるトレーナーカルーセル、数字カウントアップ、料金プラン比較まで作り込んだ試作案件。',
    cover: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1600&q=80&auto=format&fit=crop',
    accent: 'from-[#D9AD57] via-[#5A4A28] to-[#121316]',
  },
  {
    slug: 'day9-tsumugi',
    href: `${BASE}/100days/day9.html`,
    no: '05',
    title: 'お取り寄せ食品 ブランドサイト',
    sub: 'TSUMUGI',
    role: 'デザイン + 実装',
    year: '2026',
    tags: ['お取り寄せ食品', '和モダン', 'モーション豊富'],
    summary:
      '全国47都道府県の作り手から、旬の味覚を届けるお取り寄せブランドのLP。テラコッタ × クリームの和モダンな配色で、産地と食卓を結ぶ静かな物語を表現。マウス追従グラデーション、3Dティルトカード、ドラッグできる作り手カルーセル、数字カウントアップなど、しっとりとした動きを織り込んだ構成。',
    cover: 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=1600&q=80&auto=format&fit=crop',
    accent: 'from-[#F4D4B8] via-[#C54C2C] to-[#5A2A3A]',
  },
  {
    slug: 'beauty-clinic',
    href: `${BASE}/works/beauty-clinic`,
    no: '04',
    title: '美容クリニック ランディングページ',
    sub: 'Lume Aesthetic Clinic',
    role: 'デザイン + 実装',
    year: '2026',
    tags: ['美容医療', '韓国系ミニマル', 'LP'],
    summary:
      '韓国系ナチュラル × 高級感をテーマにした美容クリニック向けLP。二重整形・肌管理・小顔・医療脱毛・美容注射の5施術を訴求。Before/Afterスライダー、症例・料金・予約導線まで実装。',
    cover: 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=1600&q=80&auto=format&fit=crop',
    accent: 'from-[#E6D3C4] via-[#D9B6A2] to-[#7B5E4B]',
  },
  {
    slug: 'rabbit-clinic',
    href: `${BASE}/works/rabbit-clinic`,
    no: '03',
    title: 'うさぎ専門病院 ブランドサイト',
    sub: 'Rabbit Specialty Clinic',
    role: 'デザイン + 実装',
    year: '2026',
    tags: ['動物医療', 'エディトリアル', 'Astro + GSAP'],
    summary:
      'うさぎのためだけに設計された専門医療チームのブランドサイト。エディトリアル組版、GSAPによるリビールアニメーション、Lenisスムーススクロール、マグネティックボタンを採用。',
    cover: 'https://images.unsplash.com/photo-1535241749838-299277b6305f?w=1600&q=80&auto=format&fit=crop',
    accent: 'from-[#F9D9D4] via-[#E8A3A3] to-[#6B1F3D]',
  },
  {
    slug: 'day7-patisserie',
    href: `${BASE}/100days/day7.html`,
    no: '02',
    title: 'パティスリー ブランドサイト',
    sub: 'Pâtisserie Hidamari',
    role: 'デザイン + 実装',
    year: '2026',
    tags: ['パティスリー', '手仕事', 'ナチュラル'],
    summary:
      '三軒茶屋の小さなケーキ工房のブランドサイト。地元素材を使った日々の手仕事を、ベージュとベリーカラーで温かく表現。',
    cover: 'https://images.unsplash.com/photo-1488477181946-6428a0291777?w=1600&q=80&auto=format&fit=crop',
    accent: 'from-[#F4D4D4] via-[#D4A574] to-[#7A4A2D]',
  },
  {
    slug: 'day3-clinic',
    href: `${BASE}/100days/day3.html`,
    no: '01',
    title: '内科・皮膚科クリニック ランディングページ',
    sub: 'Aoyama Leaf Clinic',
    role: 'デザイン + 実装',
    year: '2026',
    tags: ['内科・皮膚科', 'クリーン', 'LP'],
    summary:
      '南青山の内科・皮膚科クリニックLP。淡いブルーグレーを基調にした清潔感あるデザインで、日々の不調から肌の悩みまで包括的に対応するクリニックの世界観を表現。',
    cover: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=1600&q=80&auto=format&fit=crop',
    accent: 'from-[#D8E7F3] via-[#4A8DC7] to-[#2F6BA0]',
  },
];

// マップ上の建物（下の4つのカテゴリと対応）。x,y は 16x12 マスのうち建物の左上のマス
const spots = [
  { id: 'services', label: 'サービス・ツール', x: 3, y: 1, name: 'サービス・ツール', kind: 'STAGE 1', text: '語学ツールや セルフチェックなど、まいにち つかえるものを ならべているよ。', href: '#services', cta: 'サービス・ツールを見る' },
  { id: 'days', label: '100日チャレンジ', x: 11, y: 1, name: '100日チャレンジ', kind: `Lv.${days.done} / 100`, text: `まいにち ひとつ つくって公開する塔。いま ${days.done}かいまで のぼったよ。`, href: '#days', cta: '100日チャレンジを見る' },
  { id: 'games', label: 'ゲーム', x: 3, y: 7, name: 'ゲーム', kind: 'STAGE 2', text: 'ブラウザで すぐ あそべる ゲームの おしろ。監督になったり、英雄になったり。', href: '#games', cta: 'ゲームを見る' },
  { id: 'home', label: 'mariri のいえ', x: 7, y: 7, name: 'mariri のいえ', kind: 'じこしょうかい', text: 'mariri です。サービスも ゲームも デザインも、おもいついたら つくって 公開しているよ。', href: '#about', cta: 'じこしょうかいを見る' },
  { id: 'design', label: 'Webデザイン', x: 11, y: 7, name: 'Webデザイン', kind: 'STAGE 3', text: 'クリニックやパティスリーなど、世界観からつくったサイトを かざっているよ。', href: '#design', cta: 'Webデザインを見る' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>mariri のまち — つくったものが集まるポートフォリオ</title>
    <meta name="description" content="mariri のポートフォリオ。うさぎを歩かせて、語学ツール、ブラウザゲーム、Webデザイン、100日チャレンジの作品をめぐれます。" />
    <meta name="theme-color" content="#ffd3e2" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:title" content="mariri のまち — つくったものが集まるポートフォリオ" />
    <meta property="og:description" content="うさぎを歩かせて、サービスもゲームもデザインも、つくったものをめぐれます。" />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@mariri_7777777" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${BASE}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --bg: #ffd3e2;
        --win: #fffafc;
        --ink: #4a2340;
        --muted: #96607e;
        --yellow: #e0457b;
        --pink: #b83280;
        --green: #2f8a4f;
        --cyan: #2a7fa0;
        --line: #4a2340;
      }
      html { scroll-behavior: smooth; scroll-padding-top: 16px; }
      html, body { background: var(--bg); color: var(--ink); cursor: auto; overflow-x: clip; }
      body {
        font-family: "DotGothic16", "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
        font-size: 15px;
        line-height: 1.9;
        letter-spacing: 0.04em;
        background-image:
          radial-gradient(#ffffffd0 1px, transparent 1px),
          radial-gradient(#ffffff99 2px, transparent 1px);
        background-size: 120px 120px, 76px 76px;
        background-position: 10px 20px, 40px 60px;
      }
      a { color: inherit; }
      [hidden] { display: none !important; }
      .wrap { max-width: 960px; margin-inline: auto; padding-inline: 20px; }
      /* ドット絵ふうのウィンドウ枠 */
      .win {
        background: var(--win);
        box-shadow: 0 -4px var(--line), 0 4px var(--line), -4px 0 var(--line), 4px 0 var(--line);
        margin: 4px;
      }
      .btn {
        display: inline-block;
        background: var(--yellow);
        color: #fff;
        padding: 6px 16px;
        text-decoration: none;
        box-shadow: 0 -4px var(--line), 0 4px var(--line), -4px 0 var(--line), 4px 0 var(--line), 4px 8px 0 #4a234033;
        margin: 4px;
        cursor: pointer;
        border: 0;
        font: inherit;
      }
      .btn:hover, .btn:focus-visible { background: #fff; color: var(--line); outline: none; }
      .btn:active { transform: translateY(2px); }
      :focus-visible { outline: 2px dashed var(--yellow); outline-offset: 3px; }

      /* タイトル */
      .title { text-align: center; padding: 28px 0 20px; }
      .title .logo { font-size: clamp(40px, 11vw, 64px); line-height: 1.1; color: var(--yellow); text-shadow: 4px 4px 0 #fff, 8px 8px 0 #4a234026; letter-spacing: 0.06em; }
      .title .sub { margin-top: 12px; font-size: clamp(14px, 3.6vw, 18px); color: var(--ink); }
      .blink { animation: blink 1.1s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }

      /* ゲーム画面 */
      .stage { max-width: 776px; margin-inline: auto; }
      .screen { position: relative; line-height: 0; }
      .screen canvas { width: 100%; height: auto; image-rendering: pixelated; image-rendering: crisp-edges; display: block; touch-action: manipulation; cursor: pointer; }
      .tag {
        position: absolute;
        transform: translate(-50%, -115%);
        background: #fffafcf2;
        color: var(--ink);
        font: inherit;
        font-size: clamp(9px, 2.3vw, 14px);
        line-height: 1.3;
        padding: 1px 6px;
        border: 0;
        white-space: nowrap;
        cursor: pointer;
        box-shadow: 0 -2px var(--line), 0 2px var(--line), -2px 0 var(--line), 2px 0 var(--line);
      }
      .tag:hover, .tag.on { background: var(--yellow); color: #fff; }
      .dialog { margin-top: 16px; padding: 14px 18px 16px; min-height: 148px; }
      .dialog .who { color: var(--yellow); font-size: 16px; }
      .dialog .kind { color: var(--cyan); font-size: 12px; margin-left: 10px; }
      .dialog .say { margin-top: 4px; min-height: 3.8em; }
      .dialog .act { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
      .howto { margin-top: 14px; text-align: center; font-size: 12px; color: var(--muted); }
      .tools { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 16px; }
      .about { padding: 22px 20px; display: grid; gap: 20px; grid-template-columns: 1fr; justify-items: start; }
      @media (min-width: 640px) { .about { grid-template-columns: 96px 1fr; padding: 28px; gap: 28px; } }
      .about img { width: 96px; height: 96px; image-rendering: pixelated; image-rendering: crisp-edges; }
      .about dl { margin-top: 12px; display: grid; grid-template-columns: auto 1fr; gap: 4px 16px; font-size: 14px; }
      .about dt { color: var(--yellow); white-space: nowrap; }
      .about-links { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px 12px; }
      .fishbook { margin-top: 14px; text-align: center; }
      #book { margin-top: 18px; padding: 16px; text-align: left; }
      #book-list { display: grid; gap: 14px 18px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
      #book-list li { display: flex; align-items: center; gap: 12px; }
      #book-list canvas { width: 64px; height: 40px; flex: none; image-rendering: pixelated; image-rendering: crisp-edges; background: #fffafc; box-shadow: 0 -2px var(--line), 0 2px var(--line), -2px 0 var(--line), 2px 0 var(--line); }
      #book-list .nm { color: var(--yellow); line-height: 1.5; }
      #book-list .cm { font-size: 12px; line-height: 1.6; }
      #book-list .yet .nm, #book-list .yet .cm { color: var(--muted); }
      /* パソコン幅では、マップの右にセリフ枠をならべて、スクロールなしで両方見えるようにする */
      @media (min-width: 900px) {
        .stage { max-width: none; display: grid; grid-template-columns: auto 290px; justify-content: center; align-items: stretch; gap: 0 20px; }
        .stage .screen { width: clamp(400px, calc((100vh - 240px) * 4 / 3), 580px); align-self: start; }
        .stage .dialog { margin-top: 4px; min-height: 0; display: flex; flex-direction: column; padding: 18px 20px 20px; }
        .stage .dialog .say { flex: 1; margin-top: 10px; }
        .stage .dialog .kind { display: block; margin-left: 0; }
        .stage .howto, .stage .fishbook { grid-column: 1 / -1; }
      }

      /* 作品ずかん */
      .sec { padding-top: 72px; }
      .sec-h { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 16px; margin-bottom: 24px; }
      .sec-h .no { color: var(--pink); font-size: 14px; }
      .sec-h h2 { font-size: clamp(22px, 5.4vw, 30px); font-weight: 400; color: var(--yellow); line-height: 1.4; }
      .sec-h p { font-size: 13px; color: var(--muted); width: 100%; }
      .grid { display: grid; gap: 28px 24px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
      .grid.sm { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
      .item { display: block; text-decoration: none; padding: 12px 12px 16px; position: relative; }
      a.item:hover, a.item:focus-visible { box-shadow: 0 -4px var(--yellow), 0 4px var(--yellow), -4px 0 var(--yellow), 4px 0 var(--yellow); outline: none; }
      a.item:hover .go { color: var(--yellow); }
      .item .pic { aspect-ratio: 16 / 10; overflow: hidden; background: #ffe6ef; position: relative; }
      .item .pic img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
      .item .pic.center img { object-position: center; }
      .item .pic.wide { aspect-ratio: 40 / 21; }
      .item .kind { margin-top: 12px; font-size: 12px; color: var(--cyan); }
      .item h3 { font-size: 20px; font-weight: 400; line-height: 1.5; }
      .item .txt { margin-top: 6px; font-size: 13px; color: var(--ink); line-height: 1.8; }
      .item .tags { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px; font-size: 11px; color: var(--green); }
      .item .tags li::before { content: "#"; }
      .item .go { margin-top: 12px; font-size: 13px; }
      .closed-pic { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; background: repeating-linear-gradient(135deg, #ffe6ef 0 16px, #ffd3e2 16px 32px); color: var(--yellow); line-height: 1.6; }
      .closed-pic b { display: block; font-weight: 400; font-size: 26px; color: var(--ink); }
      .badge { display: inline-block; background: var(--pink); color: #fff; font-size: 11px; padding: 0 8px; margin-left: 8px; vertical-align: middle; }

      /* 100日チャレンジ */
      .days { padding: 22px 20px 24px; display: grid; gap: 22px; grid-template-columns: 1fr; align-items: center; text-decoration: none; }
      @media (min-width: 720px) { .days { grid-template-columns: 1.1fr 1fr; padding: 28px; } }
      .lv { font-size: clamp(36px, 9vw, 56px); line-height: 1.1; color: var(--yellow); }
      .lv small { font-size: 16px; color: var(--muted); margin-left: 8px; }
      .exp { margin-top: 14px; height: 20px; background: #ffd3e2; position: relative; box-shadow: 0 -2px var(--line), 0 2px var(--line), -2px 0 var(--line), 2px 0 var(--line); }
      .exp i { position: absolute; inset: 0 auto 0 0; background: repeating-linear-gradient(90deg, var(--green) 0 6px, #3f9a4b 6px 8px); }
      .stats { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 14px; }
      .stats b { font-weight: 400; color: var(--yellow); }

      footer { margin-top: 88px; padding: 32px 0 48px; border-top: 4px dotted #4a234044; text-align: center; font-size: 13px; color: var(--muted); }
      footer .links { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 20px; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .blink { animation: none; }
      }
    </style>
  </head>
  <body id="top" class="antialiased">
    <main class="wrap">
      <header class="title">
        <h1 class="logo">mariri のまち</h1>
        <p class="sub">つくったものが あつまる ちいさなまち。</p>
      </header>

      <!-- あるけるマップ -->
      <section class="stage" aria-label="作品をめぐるマップ">
        <div class="win screen">
          <canvas id="map" width="256" height="192" tabindex="0" aria-label="うさぎを歩かせて作品の建物をめぐるマップ。建物の名前ボタンからも移動できます。"></canvas>
          {spots.map((s) => (
            <button type="button" class="tag" data-spot={s.id} style={`left:${((s.x + 1) / 16) * 100}%;top:${(s.y / 12) * 100}%`}>{s.label}</button>
          ))}
        </div>
        <div class="win dialog" aria-live="polite">
          <div><span class="who" id="dlg-who">うさぎ</span><span class="kind" id="dlg-kind"></span></div>
          <p class="say" id="dlg-say">ようこそ、mariri のまちへ。たてものの まえに たつと、つくったものを しょうかいするよ。</p>
          <div class="act">
            <a class="btn" id="dlg-go" href="#zukan" hidden>▶ ひらく</a>
            <button type="button" class="btn" id="dlg-act" hidden>▶ つりをする</button>
            <span class="blink" id="dlg-next" aria-hidden="true">▼</span>
          </div>
        </div>
        <p class="howto">タップ / やじるしキー / WASD で あるく ・ たてものの名前をおすと そこまで あるきます<br />いけの ちかくに いくと…？<br /><a href="#zukan">あるかずに 一覧でみる ▼</a></p>
        <div class="fishbook">
          <div class="tools">
            <button type="button" class="btn" id="bgm-btn" aria-pressed="false">♪ おんがく：OFF</button>
            <button type="button" class="btn" id="book-btn" aria-expanded="false" aria-controls="book" hidden>▶ つりずかん</button>
          </div>
          <div class="win" id="book" hidden><ul id="book-list"></ul></div>
        </div>
      </section>

      <!-- 作品ずかん -->
      <div id="zukan">
        <section class="sec" id="about">
          <div class="sec-h"><span class="no">PLAYER</span><h2>mariri について</h2></div>
          <div class="win about">
            <img src={`${BASE}/favicon.svg`} alt="mariri のうさぎ" width="96" height="96" />
            <div>
              <p>mariri です。思いついたものを、つくって公開しています。</p>
              <dl>
                <dt>つくるもの</dt><dd>Webサービス・ツール / ブラウザゲーム / Webサイトのデザインと実装</dd>
                <dt>いま</dt><dd>毎日ひとつ作品をつくる「100日チャレンジ」に挑戦中（{days.done} / 100）</dd>
                <dt>れんらく</dt><dd>X からどうぞ。</dd>
              </dl>
              <div class="about-links">
                <a class="btn" href="https://x.com/mariri_7777777" target="_blank" rel="noopener">X @mariri_7777777</a>
                <a class="btn" href="https://github.com/mariri777" target="_blank" rel="noopener">GitHub</a>
              </div>
            </div>
          </div>
        </section>

        <section class="sec" id="services">
          <div class="sec-h"><span class="no">STAGE 1</span><h2>サービス・ツール</h2></div>
          <div class="grid">
            {services.map((w) => {
              const Tag = w.href ? 'a' : 'div';
              const ext = w.href && w.href.startsWith('http');
              return (
                <Tag class="win item" href={w.href || undefined} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                  <div class="pic">
                    {w.cover ? <img src={w.cover} alt={`${w.title} の画面`} loading="lazy" /> : <div class="closed-pic"><div><b>{w.title}</b>ただいま じゅんびちゅう</div></div>}
                  </div>
                  <div class="kind">{w.kind}</div>
                  <h3>{w.title}{!w.href && <span class="badge">おやすみ中</span>}</h3>
