          <a class="btn" href="#top">▲ まちに もどる</a>
        </div>
        <div>© 2026 mariri</div>
      </footer>
    </main>

    <script is:inline define:vars={{ SPOTS: spots }}>
      (function () {
        var cv = document.getElementById('map');
        var ctx = cv.getContext('2d');
        var W = 16, H = 12, T = 16;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var rows = [
          'TTTTTTTTTTT..TTT',
          'T..............T',
          'T.f............T',
          'T..pp..p...pp..T',
          'TppppppppppppppT',
          'T.f...p..p..ww.T',
          'T.....p..p.fww.T',
          'T.....p..p.....T',
          'T.f...p..p.....T',
          'T..pp.pppp.pp..T',
          'TppppppppppppppT',
          'TTTTTTTTTTTTTTTT'
        ];
        var solid = [];
        for (var y = 0; y < H; y++) { solid.push([]); for (var x = 0; x < W; x++) { var c = rows[y][x]; solid[y].push(c === 'T' || c === 'w'); } }
        SPOTS.forEach(function (s) { for (var dy = 0; dy < 2; dy++) for (var dx = 0; dx < 2; dx++) solid[s.y + dy][s.x + dx] = true; });
        solid[0][11] = solid[0][12] = true;
        // かんばん（上の2軒のあいだ）。下のマスに立つと読める
        var SIGN = { id: 'sign', x: 7, y: 2, name: 'かんばん', kind: '', text: '「ここは mariri のまち」　つくったものが あつまる ちいさなまち。', href: null };
        solid[SIGN.y][SIGN.x] = true;
        function drawSign(X, Y) {
          r(X + 3, Y + 15, 10, 1, '#00000022');
          r(X + 7, Y + 10, 2, 6, '#8a5a3a');
          r(X + 1, Y + 2, 14, 9, '#8a5a3a'); r(X + 2, Y + 3, 12, 7, '#e8b877');
          r(X + 4, Y + 5, 8, 1, '#8a5a3a'); r(X + 4, Y + 7, 6, 1, '#8a5a3a');
        }

        function r(x, y, w, h, c) { ctx.fillStyle = c; ctx.fillRect(x, y, w, h); }
        function hash(x, y) { var n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453; return n - Math.floor(n); }

        function tile(x, y, t) {
          var X = x * T, Y = y * T, c = rows[y][x];
          r(X, Y, T, T, (x + y) % 2 ? '#c4ebb2' : '#cdf0bc');
          if (hash(x, y) > 0.5) { r(X + 3, Y + 5, 1, 2, '#93d193'); r(X + 11, Y + 10, 1, 2, '#93d193'); }
          if (c === 'p') {
            r(X, Y, T, T, '#fff3e0');
            r(X + 4, Y + 3, 2, 1, '#f0d6b4'); r(X + 10, Y + 11, 2, 1, '#f0d6b4'); r(X + 12, Y + 5, 1, 1, '#ffffff');
          } else if (c === 'w') {
            r(X, Y, T, T, '#9ed9f7');
            var o = Math.floor(t / 500) % 2;
            r(X + 2 + o * 2, Y + 4, 4, 1, '#ffffff'); r(X + 9 - o * 2, Y + 11, 4, 1, '#ffffff');
          } else if (c === 'f') {
            r(X + 4, Y + 6, 2, 2, '#ff7aa8'); r(X + 5, Y + 8, 1, 3, '#63b872');
            r(X + 10, Y + 3, 2, 2, '#ffd23f'); r(X + 11, Y + 5, 1, 3, '#63b872');
          } else if (c === 'T') {
            r(X + 6, Y + 10, 4, 6, '#b5805e');
            r(X + 3, Y + 1, 10, 10, '#63b872'); r(X + 1, Y + 3, 14, 6, '#63b872');
            r(X + 4, Y + 2, 5, 3, '#8fd694'); r(X + 2, Y + 5, 3, 2, '#8fd694');
            r(X + 3, Y + 10, 10, 1, '#4a9a5e');
          }
        }

        // 建物（32x32）。roofH を変えると背が高くなる
        function house(X, Y, o) {
          var i;
          r(X + 2, Y + 13, 28, 19, o.wall);
          r(X + 2, Y + 13, 28, 2, o.shade || '#00000033');
          r(X + 2, Y + 31, 28, 1, '#00000055');
          if (o.roofType === 'flat') {
            r(X + 1, Y + 2, 30, 12, o.wall); r(X, Y + 1, 32, 3, o.roof);
          } else if (o.roofType === 'castle') {
            r(X + 2, Y + 5, 28, 9, o.wall);
            for (i = 0; i < 5; i++) r(X + 2 + i * 6, Y + 1, 4, 4, o.wall);
            r(X + 2, Y + 5, 28, 1, o.roof);
          } else if (o.roofType === 'pediment') {
            for (i = 0; i < 6; i++) r(X + 14 - i * 3 + 1, Y + 2 + i * 2, 2 + i * 6, 2, o.roof);
            r(X, Y + 12, 32, 2, o.roof);
          } else {
            for (i = 0; i < 12; i++) { var inset = Math.max(0, 11 - i); r(X + inset, Y + 1 + i, 32 - inset * 2, 1, i % 4 === 3 ? o.roofDark : o.roof); }
            r(X, Y + 12, 32, 2, o.roofDark);
          }
          r(X + 13, Y + 21, 6, 11, o.door || '#6b3d1e'); r(X + 17, Y + 26, 1, 1, '#ffd23f');
          if (o.windows !== false) {
            r(X + 5, Y + 18, 5, 5, '#1b1d3a'); r(X + 6, Y + 19, 3, 3, o.glass || '#ffe58a');
            r(X + 22, Y + 18, 5, 5, '#1b1d3a'); r(X + 23, Y + 19, 3, 3, o.glass || '#ffe58a');
          }
        }
        var draw = {
          home: function (X, Y) {
            house(X, Y, { wall: '#fff3e0', roof: '#e0457b', roofDark: '#b83280', door: '#b5805e', glass: '#ffe58a' });
            r(X + 22, Y - 2, 4, 8, '#b83280'); r(X + 21, Y - 3, 6, 2, '#fffafc');
            r(X + 14, Y + 15, 1, 1, '#e0457b'); r(X + 17, Y + 15, 1, 1, '#e0457b'); r(X + 13, Y + 16, 6, 2, '#e0457b'); r(X + 14, Y + 18, 4, 1, '#e0457b'); r(X + 15, Y + 19, 2, 1, '#e0457b');
          },
          services: function (X, Y) {
            house(X, Y, { wall: '#7d84a6', roof: '#4a4f73', roofType: 'flat', windows: false, door: '#2a2c40' });
            for (var j = 0; j < 2; j++) for (var i = 0; i < 4; i++) r(X + 4 + i * 7, Y + 6 + j * 6, 4, 3, (i + j) % 2 ? '#ffe58a' : '#2a2c40');
            r(X + 4, Y + 19, 6, 5, '#ffe58a'); r(X + 22, Y + 19, 6, 5, '#ffe58a');
          },
          days: function (X, Y) {
            r(X + 8, Y - 12, 16, 26, '#f4b6c8'); r(X + 8, Y - 12, 16, 2, '#00000022');
            for (var i = 0; i < 6; i++) r(X + 6 + i * 2 - (i > 2 ? (i - 3) * 4 + 2 : 0) + (i > 2 ? 6 : 0), Y - 14 - i * 2 + (i > 2 ? (i - 3) * 4 + 2 : 0), 1, 1, '#0000');
            for (i = 0; i < 5; i++) r(X + 6 + i * 2, Y - 14 - i * 2, 20 - i * 4, 2, '#d9486e');
            r(X + 15, Y - 30, 1, 8, '#f4f1e8'); r(X + 16, Y - 30, 6, 4, '#ffd23f');
            r(X + 11, Y - 7, 3, 4, '#1b1d3a'); r(X + 18, Y - 7, 3, 4, '#1b1d3a'); r(X + 11, Y + 2, 3, 4, '#1b1d3a'); r(X + 18, Y + 2, 3, 4, '#1b1d3a');
            house(X, Y, { wall: '#ffd9e2', roof: '#d9486e', roofDark: '#a82f52', roofType: 'none-keep', glass: '#fff3b0' });
            r(X + 8, Y - 2, 16, 3, '#f4b6c8'); r(X + 11, Y + 2, 3, 4, '#1b1d3a'); r(X + 18, Y + 2, 3, 4, '#1b1d3a');
          },
          games: function (X, Y) {
            house(X, Y, { wall: '#8d93a6', roof: '#5a5f73', roofType: 'castle', door: '#3a2414', glass: '#ffb84a' });
            r(X + 15, Y - 9, 1, 10, '#f4f1e8'); r(X + 16, Y - 9, 7, 5, '#d83a3a'); r(X + 18, Y - 7, 2, 1, '#ffd23f');
            r(X + 12, Y + 19, 8, 2, '#3a2414');
          },
          design: function (X, Y) {
            house(X, Y, { wall: '#faf7f2', roof: '#a88974', roofType: 'pediment', windows: false, door: '#6e5644' });
            for (var i = 0; i < 4; i++) { r(X + 4 + i * 7 + (i > 1 ? 1 : 0), Y + 15, 3, 16, '#e3d8c8'); r(X + 4 + i * 7 + (i > 1 ? 1 : 0), Y + 15, 1, 16, '#ffffff'); }
            r(X + 13, Y + 21, 6, 11, '#6e5644');
          }
        };

        var bunny = [
          '....kk....kk....', '...kwwk..kwwk...', '...kwpk..kpwk...', '...kwpk..kpwk...',
          '...kwwk..kwwk...', '..kwwwwkkwwwwk..', '..kwwwwwwwwwwk..', '..kwwwwwwwwwwk..',
          '..kwwwwwwwwwwk..', '...kwwwwwwwwk...', '..kkwwwwwwwwkk..', '..kwwwwwwwwwwk..',
          '..kwwwwwwwwwwk..', '...kwwkkkkwwk...', '...kwwk..kwwk...', '...kkkk..kkkk...'
        ];
        var pal = { k: '#2a2440', w: '#ffffff', p: '#ffa6c4' };
        function drawBunny(px, py, dir, step) {
          var X = Math.round(px), Y = Math.round(py) - 5;
          r(X + 3, Y + 15, 10, 2, '#00000033');
          for (var y = 0; y < 16; y++) {
            var row = bunny[y], yy = Y + y;
            for (var x = 0; x < 16; x++) {
              var c = row[x]; if (c === '.') continue;
              var up = 0;
              if (y >= 13 && step) up = (x < 8) === (step === 1) ? -1 : 0;
              r(X + x, yy + up, 1, 1, pal[c]);
            }
          }
          if (dir !== 'up') {
            var sx = dir === 'left' ? -1 : dir === 'right' ? 1 : 0;
            r(X + 5 + sx, Y + 7, 1, 2, '#2a2440'); r(X + 10 + sx, Y + 7, 1, 2, '#2a2440');
            r(X + 7 + sx, Y + 9, 2, 1, '#ffa6c4');
            r(X + 4 + sx, Y + 9, 1, 1, '#ffd0de'); r(X + 11 + sx, Y + 9, 1, 1, '#ffd0de');
          } else {
            r(X + 7, Y + 12, 3, 2, '#f0f0f0');
          }
        }

        var PETS = {
          dog: { pal: { k: '#4a2f22', o: '#c98a52', d: '#8a5a3a' }, nose: '#2a2440', rows: [
            '................', '................', '................', '................',
            '...kkkkkkkkkk...', 'kdkooooooooookdk', 'kdkooooooooookdk', 'kdkooooooooookdk',
            '.kkooooooooookk.', '...kooooooook...', '..kkooooooookk..', '..koooooooooook.'.slice(0, 16),
            '..kooooooooook..', '...kookkkkook...', '...kook..kook...', '...kkkk..kkkk...'
          ] },
          cat: { pal: { k: '#3a3340', o: '#b9b3c4', d: '#8d879a' }, nose: '#ff8fb0', rows: [
            '................', '................', '..kk........kk..', '..kok......kok..',
            '..kook....kook..', '..kooookkooook..', '..kooooooooook..', '..kooooooooook..',
            '..kooooooooook..', '...kooooooook...', '..kkooooooookk..', '..kooooooooook..',
            '..kooooooooookkk', '...kookkkkookkdk', '...kook..kook.kk', '...kkkk..kkkk...'
          ] }
        };
        function drawPet(n) {
          var sp = PETS[n.id], X = Math.round(n.px), Y = Math.round(n.py) - 4;
          var step = n.moving ? (Math.floor(n.dist / 5) % 2) + 1 : 0;
          r(X + 3, Y + 15, 10, 2, '#00000026');
          for (var y = 0; y < 16; y++) {
            var row = sp.rows[y];
            for (var x = 0; x < 16; x++) {
              var c = row[x]; if (!c || c === '.') continue;
              var up = (y >= 13 && step && x < 13) ? ((x < 8) === (step === 1) ? -1 : 0) : 0;
              r(X + x, Y + y + up, 1, 1, sp.pal[c]);
            }
          }
          r(X + 5, Y + 7, 1, 2, '#2a2440'); r(X + 10, Y + 7, 1, 2, '#2a2440');
          r(X + 7, Y + 9, 2, 1, sp.nose);
          if (n.id === 'cat') { r(X + 3, Y + 9, 2, 1, '#ffffff'); r(X + 11, Y + 9, 2, 1, '#ffffff'); }
          else r(X + 7, Y + 10, 2, 1, '#e86a8a');
        }
        function drawItem(it, X, Y) {
          r(X - 1, Y - 1, 12, 8, '#fffafc'); r(X - 2, Y, 14, 6, '#fffafc');
          if (it.k === 'boot') { r(X + 3, Y, 3, 5, it.col); r(X + 3, Y + 4, 6, 2, it.col); }
          else if (it.k === 'carrot') { r(X + 1, Y + 2, 3, 2, '#4a9a5e'); r(X + 3, Y + 1, 4, 4, it.col); r(X + 7, Y + 2, 2, 2, it.col); }
          else { r(X + 2, Y + 1, 5, 4, it.col); r(X + 1, Y + 2, 7, 2, it.col); r(X + 8, Y + 1, 1, 4, it.col); r(X + 7, Y + 2, 1, 2, it.col); r(X + 2, Y + 2, 1, 1, '#2a2440'); }
        }

        var P = { tx: 7, ty: 4, px: 7 * T, py: 4 * T, dir: 'down', path: [], moving: false, dist: 0 };
        var keys = {};
        var current = null;

        function free(x, y) { return x >= 0 && y >= 0 && x < W && y < H && !solid[y][x]; }
        function findPath(sx, sy, gx, gy) {
          if (!free(gx, gy)) return [];
          var prev = {}, q = [[sx, sy]], k = function (x, y) { return x + ',' + y; };
          prev[k(sx, sy)] = null;
          while (q.length) {
            var n = q.shift();
            if (n[0] === gx && n[1] === gy) break;
            [[1, 0], [-1, 0], [0, 1], [0, -1]].forEach(function (d) {
              var nx = n[0] + d[0], ny = n[1] + d[1];
              if (free(nx, ny) && !(k(nx, ny) in prev)) { prev[k(nx, ny)] = n; q.push([nx, ny]); }
            });
          }
          if (!(k(gx, gy) in prev)) return [];
          var out = [], cur = [gx, gy];
          while (cur && !(cur[0] === sx && cur[1] === sy)) { out.unshift(cur); cur = prev[k(cur[0], cur[1])]; }
          return out;
        }
        function spotAt(x, y) {
          for (var i = 0; i < SPOTS.length; i++) { var s = SPOTS[i]; if (x >= s.x && x < s.x + 2 && y >= s.y - 1 && y < s.y + 2) return s; }
          return null;
        }
        function doorOf(x, y) {
          for (var i = 0; i < SPOTS.length; i++) { var s = SPOTS[i]; if (y === s.y + 2 && (x === s.x || x === s.x + 1)) return s; }
          if (x === SIGN.x && y === SIGN.y + 1) return SIGN;
          return null;
        }
        function goToSpot(s) {
          var a = findPath(P.tx, P.ty, s.x, s.y + 2), b = findPath(P.tx, P.ty, s.x + 1, s.y + 2);
          if (P.tx === s.x + 1 && P.ty === s.y + 2 || P.tx === s.x && P.ty === s.y + 2) { arrive(); return; }
          P.path = (b.length && b.length < a.length) ? b : a;
        }

        // せりふ
        var who = document.getElementById('dlg-who'), kind = document.getElementById('dlg-kind'), say = document.getElementById('dlg-say'), go = document.getElementById('dlg-go'), act = document.getElementById('dlg-act'), next = document.getElementById('dlg-next');
        var timer = null;
        function speak(text) {
          clearInterval(timer);
          if (reduce) { say.textContent = text; return; }
          var i = 0; say.textContent = '';
          timer = setInterval(function () { i += 2; say.textContent = text.slice(0, i); if (i >= text.length) clearInterval(timer); }, 30);
        }
        var tags = document.querySelectorAll('.tag');
        // いけ（つり）
        var POND = { id: 'pond', name: 'いけ', kind: '', text: '……？ みずの なかで なにかが うごいた。つりを してみる？', href: null };
        var CATCH = [
          { n: 'メダカ', c: 'ちいさくて すばしっこい。', w: 30, col: '#ffb347', k: 'fish' },
          { n: 'きんぎょ', c: 'あかくて ひらひら。', w: 22, col: '#ff5a5a', k: 'fish' },
          { n: 'コイ', c: 'おおきい！ うでが つかれた。', w: 14, col: '#ffffff', k: 'fish' },
          { n: 'ザリガニ', c: 'はさみに ちゅうい。', w: 12, col: '#d83a3a', k: 'fish' },
          { n: 'ながぐつ', c: 'だれの だろう…。', w: 10, col: '#8d93a6', k: 'boot' },
          { n: 'にんじん', c: 'なぜ いけに？ うさぎは うれしい。', w: 7, col: '#ff8c2a', k: 'carrot' },
          { n: 'にじいろの さかな', c: 'きらきら ひかっている！ レア！', w: 4, col: '#b07aff', k: 'fish' },
          { n: 'いけの ぬし', c: 'でんせつの おおもの！！ すごい！', w: 1, col: '#ffd23f', k: 'fish' }
        ];
        var bag = { total: 0, kinds: {} };
        try { var saved = JSON.parse(localStorage.getItem('mariri-town-fish') || 'null'); if (saved && saved.kinds) bag = saved; } catch (e) {}
        // おんがく（その場で音をつくるチップチューン。音声ファイルは使わない）
        var bgmBtn = document.getElementById('bgm-btn'), AC = null, bgmOn = false, bgmTimer = null, step8 = 0, nextTime = 0;
        var E8 = 0.24; // 8分音符の長さ（秒）
        var MELODY = [[64,2],[67,2],[72,2],[67,2], [69,2],[67,1],[64,1],[67,4], [65,2],[69,2],[67,2],[64,2], [62,3],[64,1],[62,4],
                      [64,2],[67,2],[72,2],[76,2], [74,2],[72,1],[69,1],[67,4], [69,2],[72,2],[71,2],[67,2], [72,6],[0,2]];
        var BASS = [48,55, 45,52, 41,48, 43,50, 48,55, 45,52, 41,43, 48,48];
        var melAt = {}; (function () { var t = 0; MELODY.forEach(function (n) { melAt[t] = n; t += n[1]; }); })();
        function tone(midi, when, dur, type, vol) {
          var o = AC.createOscillator(), g = AC.createGain();
          o.type = type; o.frequency.value = 440 * Math.pow(2, (midi - 69) / 12);
          g.gain.setValueAtTime(0.0001, when);
          g.gain.linearRampToValueAtTime(vol, when + 0.015);
          g.gain.setValueAtTime(vol, when + dur * 0.6);
          g.gain.exponentialRampToValueAtTime(0.0001, when + dur);
          o.connect(g); g.connect(AC.destination); o.start(when); o.stop(when + dur + 0.02);
        }
        function schedule() {
          // 時計が進んでいない（＝まだ音が出せない）ときは、ボタンに「タップしてね」と出す
          if (AC.currentTime > ctSeen) { ctSeen = AC.currentTime; if (stuck >= 12) bgmBtn.textContent = '♪ おんがく：ON'; stuck = 0; }
          else if (++stuck === 12) bgmBtn.textContent = '♪ おんがく：がめんを タップしてね';
          if (nextTime < AC.currentTime) nextTime = AC.currentTime + 0.05;
          while (nextTime < AC.currentTime + 0.4) {
            var m = melAt[step8];
            if (m && m[0]) tone(m[0], nextTime, m[1] * E8 * 0.95, 'square', 0.13);
            if (step8 % 4 === 0) tone(BASS[step8 / 4] + 12, nextTime, E8 * 3.6, 'triangle', 0.3);
            if (step8 % 2 === 1) tone(BASS[Math.floor(step8 / 4)] + 24, nextTime, E8 * 0.8, 'triangle', 0.12);
            step8 = (step8 + 1) % 64; nextTime += E8;
          }
        }
        // iPhone などは、指でふれた瞬間に「無音を1回鳴らす」と音が出せるようになる
        var ctSeen = -1, stuck = 0;
        // iPhone は「指でふれた瞬間に音源をスタートさせる」と音が出せるようになる。聞こえない音を一瞬だけ鳴らす
        function unlockAudio() {
          if (!AC) return;
          try { if (AC.resume) AC.resume(); } catch (e) {}
          try {
            var o = AC.createOscillator(), g = AC.createGain();
            g.gain.value = 0.0001; o.connect(g); g.connect(AC.destination);
            o.start(0); o.stop(AC.currentTime + 0.05);
          } catch (e) {}
        }
        ['touchend', 'pointerup', 'click', 'keydown'].forEach(function (ev) {
          if (document.addEventListener) document.addEventListener(ev, function () { if (bgmOn && AC && (AC.state !== 'running' || stuck >= 3)) unlockAudio(); }, true);
        });
        function setBgm(on) {
          var Ctor = window.AudioContext || window.webkitAudioContext;
          if (on && !Ctor) return;
          bgmOn = on;
          if (on) {
            if (!AC) AC = new Ctor();
            unlockAudio();
            step8 = 0; nextTime = AC.currentTime + 0.08; ctSeen = -1; stuck = 0;
            clearInterval(bgmTimer); bgmTimer = setInterval(schedule, 100); schedule();
          } else { clearInterval(bgmTimer); }
          bgmBtn.textContent = '♪ おんがく：' + (on ? 'ON' : 'OFF');
          bgmBtn.setAttribute('aria-pressed', String(on));
        }
        function jingle() { // つれたときの みじかい音（おんがくONのときだけ）
          if (!bgmOn || !AC) return;
          var t = AC.currentTime + 0.02; [76, 79, 84, 88].forEach(function (n, i) { tone(n, t + i * 0.08, 0.18, 'square', 0.14); });
        }
        // iPhone 対策：音の土台はページを開いた時点で作っておき（この時点では無音・停止中）、
        // おんがくボタンに指がふれた瞬間（click より前の pointerup / touchend）から準備をはじめる
        try { var Ctor0 = window.AudioContext || window.webkitAudioContext; if (Ctor0) AC = new Ctor0(); } catch (e) {}
        ['pointerup', 'touchend'].forEach(function (ev) { bgmBtn.addEventListener(ev, function () { if (!bgmOn) unlockAudio(); }); });
        bgmBtn.addEventListener('click', function () { setBgm(!bgmOn); });
        if (document.addEventListener) document.addEventListener('visibilitychange', function () {
          if (!bgmOn || !AC) return;
          if (document.hidden) { clearInterval(bgmTimer); }
          else { nextTime = AC.currentTime + 0.08; clearInterval(bgmTimer); bgmTimer = setInterval(schedule, 100); }
        });

        // つりずかん
        var bookBtn = document.getElementById('book-btn'), book = document.getElementById('book'), bookList = document.getElementById('book-list');
        function renderBook() {
          var got = 0;
          bookList.textContent = '';
          CATCH.forEach(function (it, i) {
            var n = bag.kinds[it.n] || 0; if (n) got++;
            var li = document.createElement('li'), c = document.createElement('canvas'), d = document.createElement('div');
            c.width = 16; c.height = 10;
            var main = ctx; ctx = c.getContext('2d');
            if (n) drawItem(it, 3, 2); else { r(0, 0, 16, 10, '#ffd3e2'); r(7, 2, 2, 3, '#96607e'); r(7, 6, 2, 2, '#96607e'); }
            ctx = main;
            var nm = document.createElement('div'), cm = document.createElement('div');
            nm.className = 'nm'; cm.className = 'cm';
            nm.textContent = 'No.' + (i + 1) + ' ' + (n ? it.n : '？？？');
            cm.textContent = n ? it.c + ' （' + n + 'かい）' : 'まだ つれていない';
            if (!n) li.className = 'yet';
            d.appendChild(nm); d.appendChild(cm); li.appendChild(c); li.appendChild(d); bookList.appendChild(li);
          });
          // ずかんは、はじめて なにかを つるまで かくしておく
          bookBtn.hidden = !bag.total && book.hidden;
          bookBtn.textContent = (book.hidden ? '▶' : '▼') + ' つりずかん ' + got + '/' + CATCH.length;
        }
        bookBtn.addEventListener('click', function () { book.hidden = !book.hidden; bookBtn.setAttribute('aria-expanded', String(!book.hidden)); renderBook(); });
        if (/[?&]book=1/.test(location.search)) book.hidden = false; // ?book=1 でずかんを開いた状態ではじまる
        renderBook();
        var fishing = null; // { timer, bite, wx, wy }
        var caught = null;  // { item, until }
        function waterDir(x, y) {
          for (var k in DIRS) { var nx = x + DIRS[k][0], ny = y + DIRS[k][1]; if (rows[ny] && rows[ny][nx] === 'w') return k; }
          return null;
        }
        function cancelFish() { if (fishing) { clearTimeout(fishing.timer); fishing = null; } caught = null; }
        function startFish() {
          var d = waterDir(P.tx, P.ty);
          if (!d || fishing) return;
          P.dir = d; caught = null; act.hidden = true;
          speak('つりざおを ふった！ ………');
          fishing = { bite: false, wx: (P.tx + DIRS[d][0]) * T + 7, wy: (P.ty + DIRS[d][1]) * T + 7 };
          fishing.timer = setTimeout(function () {
            fishing.bite = true;
            fishing.timer = setTimeout(function () {
              var sum = 0, i, pick = CATCH[0];
              for (i = 0; i < CATCH.length; i++) sum += CATCH[i].w;
              var roll = Math.random() * sum;
              for (i = 0; i < CATCH.length; i++) { roll -= CATCH[i].w; if (roll < 0) { pick = CATCH[i]; break; } }
              bag.total += 1; bag.kinds[pick.n] = (bag.kinds[pick.n] || 0) + 1;
              try { localStorage.setItem('mariri-town-fish', JSON.stringify(bag)); } catch (e) {}
              fishing = null; caught = { item: pick, until: lastT + 3500 };
              speak('「' + pick.n + '」が つれた！ ' + pick.c + '（これまでに ' + bag.total + 'かい・ずかん ' + Object.keys(bag.kinds).length + '/' + CATCH.length + '）');
              act.hidden = false; act.textContent = '▶ もういちど つる';
              renderBook(); jingle();
            }, 600);
          }, 1200 + Math.random() * 1800);
        }

        // いぬ と ねこ（まちを きままに あるく）
        var NPCS = [
          { id: 'dog', name: 'いぬ', kind: '', href: null, tx: 4, ty: 5, lines: ['わん！', 'わんわん！（しっぽを ふっている）', 'くぅーん。（なでて ほしそう）'] },
          { id: 'cat', name: 'ねこ', kind: '', href: null, tx: 10, ty: 8, lines: ['にゃーん。', 'ごろごろ…。', '……。（ぷいっと そっぽを むいた）'] }
        ];
        NPCS.forEach(function (n) { n.px = n.tx * T; n.py = n.ty * T; n.wait = 1000 + Math.random() * 2000; n.dist = 0; n.moving = false; });
        function npcNear() {
          for (var i = 0; i < NPCS.length; i++) { var n = NPCS[i]; if (Math.abs(n.tx - P.tx) + Math.abs(n.ty - P.ty) <= 1) return n; }
          return null;
        }
        function updateNpc(n, dt) {
          var gx = n.tx * T, gy = n.ty * T;
          if (n.px !== gx || n.py !== gy) {
            var m = 28 * dt / 1000, dx = gx - n.px, dy = gy - n.py;
            if (Math.abs(dx) + Math.abs(dy) <= m) { n.px = gx; n.py = gy; n.moving = false; }
            else { n.px += Math.sign(dx) * m; n.py += Math.sign(dy) * m; n.dist += m; n.moving = true; }
            return;
          }
          n.wait -= dt;
          if (n.wait > 0 || reduce) return;
          n.wait = 900 + Math.random() * 2600;
          var ks = ['up', 'down', 'left', 'right'], d = DIRS[ks[Math.floor(Math.random() * 4)]];
          var nx = n.tx + d[0], ny = n.ty + d[1];
          if (free(nx, ny) && !(nx === P.tx && ny === P.ty) && !doorOf(nx, ny)) { n.tx = nx; n.ty = ny; }
        }

        function arrive() {
          var s = doorOf(P.tx, P.ty), wd = null, npc = null;
          if (!s) { wd = waterDir(P.tx, P.ty); if (wd) s = POND; }
          if (!s) { npc = npcNear(); if (npc) s = npc; }
          if (s === current) return;
          current = s;
          tags.forEach(function (t) { t.classList.toggle('on', !!s && t.dataset.spot === s.id); });
          act.hidden = true;
          if (!s) {
            who.textContent = 'うさぎ'; kind.textContent = ''; go.hidden = true; next.hidden = false;
            speak('きになる たてものの まえまで あるいてみてね。');
            return;
          }
          if (npc) { npc.wait = 4000; npc.text = npc.lines[Math.floor(Math.random() * npc.lines.length)]; }
          else if (wd) { P.dir = wd; act.hidden = false; act.textContent = '▶ つりをする'; }
          else P.dir = 'up';
          who.textContent = s.name; kind.textContent = s.kind; next.hidden = true;
          speak(s.text);
          if (s.href) {
            go.hidden = false; go.href = s.href; go.textContent = '▶ ' + s.cta;
            if (/^https?:/.test(s.href)) { go.target = '_blank'; go.rel = 'noopener'; } else { go.removeAttribute('target'); go.removeAttribute('rel'); }
          } else { go.hidden = true; }
        }
        function walkTo(path) { if (path === null) return; if (!path.length) { current = undefined; arrive(); } else P.path = path; }
        function pathToPond() {
          if (waterDir(P.tx, P.ty)) return [];
          var best = null;
          for (var y = 0; y < H; y++) for (var x = 0; x < W; x++) {
            if (!free(x, y) || !waterDir(x, y)) continue;
            var pth = findPath(P.tx, P.ty, x, y);
            if (pth.length && (!best || pth.length < best.length)) best = pth;
          }
          return best;
        }

        cv.addEventListener('click', function (e) {
          var b = cv.getBoundingClientRect();
          var x = Math.floor((e.clientX - b.left) / b.width * W), y = Math.floor((e.clientY - b.top) / b.height * H);
          var s = spotAt(x, y), i;
          for (i = 0; i < NPCS.length; i++) {
            var n = NPCS[i];
            if (Math.round(n.px / T) === x && Math.round(n.py / T) === y) {
              n.wait = 6000;
              if (Math.abs(n.tx - P.tx) + Math.abs(n.ty - P.ty) <= 1) { walkTo([]); return; }
              var pth = findPath(P.tx, P.ty, n.tx, n.ty); pth.pop(); walkTo(pth); return;
            }
          }
          if (s) goToSpot(s);
          else if (rows[y] && rows[y][x] === 'w') walkTo(pathToPond());
          else if (x === SIGN.x && y === SIGN.y) { if (P.tx === SIGN.x && P.ty === SIGN.y + 1) arrive(); else P.path = findPath(P.tx, P.ty, SIGN.x, SIGN.y + 1); }
          else P.path = findPath(P.tx, P.ty, x, y);
        });
        act.addEventListener('click', startFish);
        tags.forEach(function (t) {
          t.addEventListener('click', function () { var s = SPOTS.filter(function (v) { return v.id === t.dataset.spot; })[0]; if (s) goToSpot(s); });
        });
        var inView = true;
        if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { inView = es[0].isIntersecting && es[0].intersectionRatio > 0.6; }, { threshold: [0, 0.6, 1] }).observe(cv);
        var KEYMAP = { ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right', w: 'up', s: 'down', a: 'left', d: 'right', W: 'up', S: 'down', A: 'left', D: 'right' };
        window.addEventListener('keydown', function (e) {
          if (!inView || e.metaKey || e.ctrlKey || e.altKey) return;
          var tg = e.target && e.target.tagName;
          if (KEYMAP[e.key]) { keys[KEYMAP[e.key]] = true; P.path = []; e.preventDefault(); }
          else if ((e.key === 'Enter' || e.key === ' ') && current && tg !== 'A' && tg !== 'BUTTON') {
            if (!act.hidden) { e.preventDefault(); startFish(); }
            else if (current.href) { e.preventDefault(); go.click(); }
          }
        });
        window.addEventListener('keyup', function (e) { if (KEYMAP[e.key]) keys[KEYMAP[e.key]] = false; });
        window.addEventListener('blur', function () { keys = {}; });

        var DIRS = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] };
        function nextStep() {
          var d = null, k;
          if (P.path.length) {
            var n = P.path.shift();
            for (k in DIRS) if (DIRS[k][0] === n[0] - P.tx && DIRS[k][1] === n[1] - P.ty) d = k;
          } else {
            for (k in DIRS) if (keys[k]) { d = k; break; }
            if (d) { P.dir = d; if (!free(P.tx + DIRS[d][0], P.ty + DIRS[d][1])) d = null; }
          }
          if (!d) { P.moving = false; return; }
          cancelFish();
          P.dir = d; P.tx += DIRS[d][0]; P.ty += DIRS[d][1]; P.moving = true;
        }

        var last = 0, lastT = 0;
        function frame(t) {
          var dt = Math.min(50, t - last); last = t; lastT = t;
          var left = 80 * dt / 1000;
          while (left > 0) {
            var gx = P.tx * T, gy = P.ty * T, dx = gx - P.px, dy = gy - P.py, dist = Math.abs(dx) + Math.abs(dy);
            if (dist === 0) { if (P.moving) { arrive(); } nextStep(); if (!P.moving) break; continue; }
            var m = Math.min(left, dist);
            P.px += Math.sign(dx) * m; P.py += Math.sign(dy) * m; P.dist += m; left -= m;
          }
          for (var y = 0; y < H; y++) for (var x = 0; x < W; x++) tile(x, y, reduce ? 0 : t);
          SPOTS.forEach(function (s) { draw[s.id](s.x * T, s.y * T); });
          drawSign(SIGN.x * T, SIGN.y * T);
          NPCS.forEach(function (n) { updateNpc(n, dt); });
          var actors = NPCS.concat([P]).sort(function (a, b) { return a.py - b.py; });
          actors.forEach(function (a) {
            if (a === P) drawBunny(P.px, P.py, P.dir, P.moving ? (Math.floor(P.dist / 6) % 2) + 1 : 0);
            else drawPet(a);
          });
          var hx = Math.round(P.px), hy = Math.round(P.py) - 5;
          if (fishing) {
            var bob = reduce ? 0 : Math.floor(t / 300) % 2;
            var tipx = hx + 8 + DIRS[P.dir][0] * 8, tipy = hy + (P.dir === 'down' ? 12 : 0), i;
            for (i = 0; i <= 8; i++) r(Math.round(hx + 8 + (tipx - hx - 8) * i / 8), Math.round(hy + 10 + (tipy - hy - 10) * i / 8), 2, 1, '#8a5a3a');
            for (i = 0; i <= 10; i++) r(Math.round(tipx + (fishing.wx - tipx) * i / 10), Math.round(tipy + (fishing.wy + bob - tipy) * i / 10), 1, 1, '#4a2340');
            r(fishing.wx - 1, fishing.wy + bob - 1, 3, 3, '#ff5a5a'); r(fishing.wx, fishing.wy + bob - 1, 1, 1, '#ffffff');
            if (fishing.bite) { r(hx + 7, hy - 9, 2, 5, '#e0457b'); r(hx + 7, hy - 3, 2, 2, '#e0457b'); }
          }
          if (caught) {
            if (t > caught.until) caught = null;
            else drawItem(caught.item, hx + 3, hy - 9);
          }
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
        // ?spot=soccer のように付けると、その建物まで歩いた状態ではじまる
        var m = /[?&]spot=([a-z]+)/.exec(location.search);
        if (m) { var first = SPOTS.filter(function (v) { return v.id === m[1]; })[0]; if (first) goToSpot(first); else if (m[1] === 'sign') P.path = findPath(P.tx, P.ty, SIGN.x, SIGN.y + 1); }
      })();
    </script>
